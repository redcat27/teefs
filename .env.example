# teefs 环境变量
# 用法：复制成 .env 再填值（.env 已被 git 忽略）
#   cp .env.example .env

# Neon Postgres 连接串。
# 在 Neon Console → 你的项目 → Dashboard → Connect，选 "Connection string" 复制。
# 一定要用带 ?sslmode=require 的 pooled 连接串（postgres:// 开头，不是 pooler 之外的 direct 串）。
DATABASE_URL="postgresql://USER:PASSWORD@HOST/teefs?sslmode=require"
